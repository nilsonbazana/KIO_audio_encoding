[Desktop Entry]
Type=Service
MimeType=audio/x-flac;audio/flac;
Actions=qaacConvert;
X-KDE-Priority=TopLevel
X-KDE-Submenu=Audio Tools

[Desktop Action qaacConvert]
Name=Compress to QAAC + M4A
Icon=audio-x-generic
Exec=konsole -e bash -c 'ENCODER_DIR="/mnt/shared/THE MUSIC COLLECTION/_CODECS/QAAC - all necessary files"; cd "$ENCODER_DIR" || exit; for f in "$@"; do base_dir=$(dirname "$f"); artist=$(metaflac --show-tag=ALBUMARTIST "$f" | cut -d= -f2); [ -z "$artist" ] && artist=$(metaflac --show-tag=ARTIST "$f" | cut -d= -f2); date=$(metaflac --show-tag=DATE "$f" | cut -d= -f2); album=$(metaflac --show-tag=ALBUM "$f" | cut -d= -f2); [ -z "$artist" ] && artist="Unknown Artist"; [ -z "$date" ] && date="Unknown Date"; [ -z "$album" ] && album="Unknown Album"; target_dir="$base_dir/$artist/$date-$album"; mkdir -p "$target_dir"; out="$target_dir/$(basename "${f%.*}.m4a")"; flac -d -c "$f" | wine qaac64.exe -V 91 --no-delay --ignorelength -o "$out" -; done' _ %F
