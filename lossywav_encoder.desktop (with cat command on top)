cat << 'INPUT_EOF' > ~/.local/share/kio/servicemenus/lossywav_encoder.desktop
[Desktop Entry]
Type=Service
MimeType=audio/x-flac;audio/flac;
Actions=lossywavConvert;
X-KDE-Priority=TopLevel
X-KDE-Submenu=Audio Tools

[Desktop Action lossywavConvert]
Name=Compress to lossyWAV + FLAC
Icon=audio-x-generic
Exec=konsole -e bash -c 'ENCODER_DIR="/mnt/shared/THE MUSIC COLLECTION/_CODECS/lossyWAV"; cd "$ENCODER_DIR" || exit; for f in "$@"; do base_dir=$(dirname "$f"); artist=$(metaflac --show-tag=ALBUMARTIST "$f" | cut -d= -f2); [ -z "$artist" ] && artist=$(metaflac --show-tag=ARTIST "$f" | cut -d= -f2); date=$(metaflac --show-tag=DATE "$f" | cut -d= -f2); album=$(metaflac --show-tag=ALBUM "$f" | cut -d= -f2); [ -z "$artist" ] && artist="Unknown Artist"; [ -z "$date" ] && date="Unknown Date"; [ -z "$album" ] && album="Unknown Album"; target_dir="$base_dir/$artist/$date-$album"; mkdir -p "$target_dir"; out="$target_dir/$(basename "${f%.*}.lossy.flac")"; flac -d -c "$f" | wine lossyWAV.exe - --quality high --silent --stdout | wine flac.exe - -b 512 -5 -f --silent --ignore-chunk-sizes -o "$out" && metaflac --export-tags-to=- "$f" | metaflac --import-tags-from=- "$out"; done' _ %F
INPUT_EOF

chmod +x ~/.local/share/kio/servicemenus/lossywav_encoder.desktop
kbuildsycoca5 --noincremental
